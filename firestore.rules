rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - photoURL: string
    //   - role: string (required, 'employee' or 'admin')
    //   - points: number
    //   - badges: list
    //   - completedModules: list
    //   - createdAt: timestamp
    //
    // Collection: modules
    // Document ID: {moduleId}
    // Fields:
    //   - id: string
    //   - title: string
    //   - content: string
    //   - category: string
    //   - duration: string
    //   - points: number
    //
    // Collection: assessments
    // Document ID: {assessmentId}
    // Fields:
    //   - userId: string (required)
    //   - mood: number
    //   - stressLevel: number
    //   - notes: string
    //   - createdAt: timestamp
    //
    // Collection: consultations
    // Document ID: {consultationId}
    // Fields:
    //   - userId: string (required)
    //   - expertName: string
    //   - scheduledAt: timestamp
    //   - status: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "david.murphy@marketing4startups.net" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['employee', 'admin'] &&
             (!('points' in data) || data.points is number) &&
             (!('badges' in data) || data.badges is list) &&
             (!('completedModules' in data) || data.completedModules is list);
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['userId', 'mood', 'stressLevel', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.mood is number && data.mood >= 1 && data.mood <= 5 &&
             data.stressLevel is number && data.stressLevel >= 1 && data.stressLevel <= 5 &&
             data.createdAt is timestamp;
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['userId', 'expertName', 'scheduledAt', 'status']) &&
             data.userId is string &&
             data.expertName is string &&
             data.scheduledAt is timestamp &&
             data.status in ['scheduled', 'completed', 'cancelled'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                      (isOwner(userId) && request.resource.data.role == 'employee' || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                      (isOwner(userId) && request.resource.data.role == resource.data.role || isAdmin());
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assessments/{assessmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAssessment(request.resource.data);
      allow update, delete: if false; // Assessments are immutable for history
    }

    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidConsultation(request.resource.data) && 
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
